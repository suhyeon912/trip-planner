rules_version = '2';
// 여행 플래너 공유·초대용 Firestore 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 그대로 붙여 넣고 '게시'
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{code} {
      // 코드를 아는 로그인 사용자만 한 건씩 읽기 (전체 목록 조회는 막음)
      allow get: if request.auth != null;
      allow list: if false;
      // 처음 공유: 만든 사람이 유일한 멤버 (닉네임 names 도 자기 것만)
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.get('names', {}).keys().hasOnly([request.auth.uid]);
      // 멤버는 내용 수정 가능 (owner·members·names 는 못 바꿈)
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.members
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members == resource.data.members
          && request.resource.data.get('names', {}) == resource.data.get('names', {}))
        // 참여: 코드를 아는 사람이 members 에 자기 자신만 추가 (+ 자기 닉네임)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid]))
        // 나가기: members 에서 자기 자신만 빼기 (+ 자기 닉네임)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names'])
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid]))
      );
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerUid;
    }
  }
}
