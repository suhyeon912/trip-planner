<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      앱 테마 (Material 컴포넌트 없이 AppCompat 위에 TripPlanner 디자인 시스템).
      버튼 · 입력칸 · 탭 · 스위치 · 팝업 · 알림은 모두 자체 컴포넌트(ui/widget)이고, 여기서는 색 · 글자 · 모양만 정합니다.
    -->
    <style name="Theme.TripPlanner" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/primary</item>
        <!-- 커서 · 글자 선택 손잡이 · 체크 등 -->
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlNormal">@color/text_sub</item>
        <item name="android:textColorHighlight">@color/primary_light</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- 기본 글자색 -->
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:textColorTertiary">@color/text_sub</item>
        <item name="android:textColorHint">@color/outline</item>
        <!-- 글꼴: Pretendard (가장 얇은 굵기 = Medium) -->
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <!-- 상태 표시줄: 화면 배경과 같은 색 (다크 모드는 values-night 의 background) · 아이콘은 배경에 맞춰 어둡게/밝게 -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <!-- 공통 컴포넌트 -->
        <item name="actionBarSize">64dp</item>
        <item name="toolbarStyle">@style/Widget.TripPlanner.Toolbar</item>
        <item name="tpButtonStyle">@style/Widget.TripPlanner.Button</item>
        <item name="tpFabStyle">@style/Widget.TripPlanner.Fab</item>
        <item name="android:dropDownListViewStyle">@style/Widget.TripPlanner.PopupList</item>
        <item name="android:listPreferredItemHeightSmall">48dp</item>
        <item name="listPreferredItemHeightSmall">48dp</item>
        <item name="android:textViewStyle">@style/Widget.TripPlanner.TextView</item>
        <!-- 스크롤 막대: 폭 4 · 모서리 2 · on_surface 32% · 멈추면 1초 뒤 사라짐 -->
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarThumbHorizontal">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarSize">4dp</item>
        <item name="android:scrollbarDefaultDelayBeforeFade">1000</item>
        <item name="android:scrollbarFadeDuration">300</item>
        <!-- 눌림: 물결(ripple) 대신 평평한 12% 덧칠 (시안 '누름' 상태) -->
        <item name="selectableItemBackground">@drawable/press_overlay</item>
        <item name="android:selectableItemBackground">@drawable/press_overlay</item>
        <item name="selectableItemBackgroundBorderless">@drawable/press_overlay_borderless</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/press_overlay_borderless</item>
        <item name="android:colorControlHighlight">@color/press_on_surface</item>
        <item name="colorControlHighlight">@color/press_on_surface</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/press_overlay</item>
        <item name="listChoiceBackgroundIndicator">@drawable/press_overlay</item>
    </style>

    <!-- 표지 사진 맞추기: 어두운 화면이라 상태 표시줄도 어둡게, 아이콘은 밝게 -->
    <style name="Theme.TripPlanner.Crop">
        <item name="android:statusBarColor">@color/crop_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 팝업 (TpDialog): 떠 있는 창 · 바탕 45% 어둡게 -->
    <style name="Theme.TripPlanner.Popup" parent="Theme.TripPlanner">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
    </style>
    <style name="Animation.TripPlanner.Dialog" parent="">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>

    <!--
      글자 역할 (글꼴 Pretendard, 최소 12sp, 글자 간격 0).
      굵기: 본문·보조 = Medium(가장 얇음) / 버튼·탭·작은 제목 = SemiBold / 큰 제목 = Bold
    -->
    <style name="TextAppearance.TripPlanner.TitleLarge" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="lineHeight">28sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TripPlanner.TitleMedium" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TripPlanner.TitleSmall" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TripPlanner.BodyLarge" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TripPlanner.BodyMedium" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TripPlanner.BodySmall" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TripPlanner.LabelLarge" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard_semibold</item>
        <item name="fontFamily">@font/pretendard_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TripPlanner.LabelMedium" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.TripPlanner.LabelSmall" parent="TextAppearance.AppCompat">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="fontFamily">@font/pretendard</item>
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- 공통 위젯 스타일 -->

    <!-- 3단계 공통 위젯 스타일 -->
    <style name="Widget.TripPlanner.SummaryRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/space_m</item>
        <item name="android:paddingVertical">@dimen/space_xs</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="Widget.TripPlanner.SummaryIcon" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">@dimen/space_m</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.TripPlanner.SummaryChevron" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">@dimen/space_s</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Widget.TripPlanner.Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">1dp</item>
        <item name="android:textAppearance">@style/TextAppearance.TripPlanner.LabelMedium</item>
    </style>

    <!-- 하단 고정 바: 높이 80 · 위 12 · 아래 20 · 좌우 16 · 위 경계선 -->
    <style name="Widget.TripPlanner.BottomBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">80dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_bottom_bar</item>
        <item name="android:paddingStart">@dimen/screen_margin</item>
        <item name="android:paddingEnd">@dimen/screen_margin</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <!-- 여행 카드 정보 줄: 작은 아이콘 + 글자 -->
    <style name="Widget.TripPlanner.TripInfoLine" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.TripPlanner.BodyMedium</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="drawableTint">@color/text_sub</item>
    </style>

    <!-- 6단계: 편집 화면 섹션 제목 -->
    <style name="Widget.TripPlanner.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:accessibilityHeading" tools:targetApi="28">true</item>
        <item name="android:textAppearance">@style/TextAppearance.TripPlanner.LabelLarge</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>
    <style name="Widget.TripPlanner.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- 한글은 단어 단위로 줄바꿈 (Android 13+, 그 아래는 무시) -->
    <style name="Widget.TripPlanner.TextView" parent="android:Widget.TextView">
        <item name="android:lineBreakWordStyle" tools:targetApi="33">phrase</item>
    </style>

    <!-- 상단 바: 높이 64 · 좌우 16 · 제목 18 SemiBold -->
    <style name="Widget.TripPlanner.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:minHeight">64dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.TripPlanner.TitleMedium</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.TripPlanner.BodySmall</item>
        <item name="titleTextColor">@color/on_surface</item>
        <item name="subtitleTextColor">@color/text_sub</item>
        <item name="contentInsetStart">16dp</item>
        <item name="contentInsetStartWithNavigation">56dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:background">@color/background</item>
    </style>

    <!--
      버튼 (TpButton): 알약 · 높이 48 · 글자 14 SemiBold · 눌림 12% 덧칠
      primary 색은 누를 수 있는 것에만, 채움 버튼은 화면마다 하나
    -->
    <style name="Widget.TripPlanner.Button" parent="">
        <item name="android:background">@drawable/bg_btn_filled</item>
        <item name="android:foreground">@drawable/press_pill_on_primary</item>
        <item name="android:textColor">@color/btn_text_on_primary</item>
        <item name="tpIconTint">@color/btn_text_on_primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.TripPlanner.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.TripPlanner.Button.Danger">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/btn_text_white</item>
        <item name="tpIconTint">@color/btn_text_white</item>
    </style>
    <style name="Widget.TripPlanner.Button.Tonal">
        <item name="android:background">@drawable/bg_btn_tonal</item>
        <item name="android:foreground">@drawable/press_pill_primary</item>
        <item name="android:textColor">@color/btn_text_tonal</item>
        <item name="tpIconTint">@color/btn_text_tonal</item>
    </style>
    <style name="Widget.TripPlanner.Button.Outlined">
        <item name="android:background">@drawable/bg_btn_outlined</item>
        <item name="android:foreground">@drawable/press_pill_primary</item>
        <item name="android:textColor">@color/btn_text_primary</item>
        <item name="tpIconTint">@color/btn_text_primary</item>
    </style>
    <style name="Widget.TripPlanner.Button.Outlined.Icon">
        <item name="android:paddingStart">16dp</item>
        <item name="tpIconPadding">8dp</item>
        <item name="tpIconSize">20dp</item>
    </style>
    <!-- 네모난 테두리 버튼: 높이 44 · 모서리 12 (장소 정보의 지도 버튼) -->
    <style name="Widget.TripPlanner.Button.Outlined.Rect">
        <item name="android:background">@drawable/bg_btn_outlined_rect</item>
        <item name="android:foreground">@drawable/press_r12_primary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="tpIconPadding">6dp</item>
        <item name="tpIconSize">18dp</item>
    </style>
    <!-- 작은 버튼: 높이 40 · 테두리 (예: 후보 탭 확정하기) -->
    <style name="Widget.TripPlanner.Button.Small" parent="Widget.TripPlanner.Button.Outlined">
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="tpIconSize">16dp</item>
        <item name="tpIconPadding">4dp</item>
    </style>
    <style name="Widget.TripPlanner.Button.Text">
        <item name="android:background">@null</item>
        <item name="android:foreground">@drawable/press_pill_primary</item>
        <item name="android:textColor">@color/btn_text_primary</item>
        <item name="tpIconTint">@color/btn_text_primary</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="Widget.TripPlanner.Button.Text.Icon">
        <item name="tpIconPadding">8dp</item>
        <item name="tpIconSize">20dp</item>
    </style>
    <style name="Widget.TripPlanner.Button.Text.Danger">
        <item name="android:textColor">@color/btn_text_danger</item>
    </style>
    <!-- 목록 아래 '추가' 점선 버튼: 모서리 12 -->
    <style name="Widget.TripPlanner.Button.DashedAdd" parent="Widget.TripPlanner.Button.Text.Icon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:background">@drawable/bg_dashed_add</item>
        <item name="android:foreground">@drawable/press_r12_primary</item>
        <item name="tpIconGravity">textStart</item>
    </style>
    <!-- 아이콘 버튼: 48 터치 · 아이콘 24 · 바탕 없음 -->
    <style name="Widget.TripPlanner.IconButton" parent="Widget.TripPlanner.Button">
        <item name="android:background">@null</item>
        <item name="android:foreground">@drawable/press_overlay_borderless</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="tpIconSize">24dp</item>
        <item name="tpIconTint">@color/on_surface</item>
    </style>
    <!-- 떠 있는 추가 버튼 (TpFab): 높이 56 · 모서리 16 · 그림자 -->
    <style name="Widget.TripPlanner.Fab" parent="Widget.TripPlanner.Button">
        <item name="android:background">@drawable/bg_fab</item>
        <item name="android:foreground">@drawable/press_r16_on_primary</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:elevation">6dp</item>
        <item name="tpIconSize">24dp</item>
        <item name="tpIconPadding">12dp</item>
    </style>
    <!-- 세그먼트 칸 (SegmentedGroup 안) -->
    <style name="Widget.TripPlanner.SegmentedButton" parent="Widget.TripPlanner.Button">
        <item name="android:background">@drawable/bg_segment_btn</item>
        <item name="android:foreground">@drawable/press_r10</item>
        <item name="android:textColor">@color/segmented_text</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!-- 칸 위 라벨 12 · 필수 칸은 라벨 끝에 * -->
    <style name="Widget.TripPlanner.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.TripPlanner.LabelMedium</item>
        <item name="android:textColor">@color/text_sub</item>
    </style>
    <style name="Widget.TripPlanner.SegmentedGroup" parent="">
        <item name="android:background">@drawable/bg_segmented</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="Widget.TripPlanner.PopupList" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:divider">@null</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- 팝오버 · 메뉴 등장/사라짐 -->
    <style name="Animation.TripPlanner.Popover" parent="">
        <item name="android:windowEnterAnimation">@anim/popover_enter</item>
        <item name="android:windowExitAnimation">@anim/popover_exit</item>
    </style>

    <!-- 전체 화면 달력 (기간 고르기): 아래에서 올라오는 입력 화면 -->
    <style name="Theme.TripPlanner.FullScreenDialog" parent="Theme.TripPlanner">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowAnimationStyle">@style/Animation.TripPlanner.SheetUp</item>
    </style>
    <style name="Animation.TripPlanner.SheetUp" parent="">
        <item name="android:windowEnterAnimation">@anim/sheet_up_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_down_exit</item>
    </style>
</resources>
