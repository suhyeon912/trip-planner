<?xml version="1.0" encoding="utf-8"?>
<!--
  여행 상세 (시안 Detail · DetailAll)
  ┌ 상단 바(뒤로 · 여행 이름 / 공유 중 · 코드 · 지도 · 공유)   ← 고정
  ├ 세그먼트 탭(일정 n / 후보 n) + 일차 칩 (가로 스크롤)        ← 고정
  ├ 목록: 일차 제목 · 숙소 출발 · 장소 · 숙소 도착 · 여행 메모
  └ 아래: [n일차 경로 제안 보기] [+]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.tripplanner.ui.widget.TopBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tpScrollTarget="@id/rvPlaces">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/trip_detail" />

        <!-- 세그먼트 바탕(안쪽 4)은 감싸는 칸이 그림: TabLayout 자체 패딩은 고정 모드에서 오른쪽이 무시되어 고른 칸이 끝에 붙음 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:background="@drawable/bg_segmented"
            android:padding="4dp">

            <com.tripplanner.ui.widget.TpTabs
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <!-- 일차 칩 줄 (일정 탭에서만 보임, 넘치면 가로 스크롤) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_m"
            android:paddingBottom="@dimen/space_xs"
            android:requiresFadingEdge="horizontal"
            android:fadingEdgeLength="32dp" />
    </com.tripplanner.ui.widget.TopBarLayout>

    <!-- 상단 바 아래 내용 (목록 + 위에 뜨는 버튼) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaces"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="96dp"
            android:scrollbars="vertical" />

        <!-- 지도로 보기 (목록과 번갈아 보임) -->
        <include layout="@layout/view_trip_map" />
    </FrameLayout>

    <!-- 아래: 경로 제안(그날을 고른 경우) + 장소 추가 -->
    <LinearLayout
        android:id="@+id/bottomActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:padding="@dimen/space_l">

        <com.tripplanner.ui.widget.TpButton
            android:id="@+id/btnRouteCta"
            style="@style/Widget.TripPlanner.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_weight="1"
            android:visibility="gone"
            app:tpIcon="@drawable/ic_route"
            app:tpIconGravity="textStart"
            app:tpIconTint="@color/on_secondary_container" />

        <com.tripplanner.ui.widget.TpFab
            android:id="@+id/fabAddPlace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/add_place"
            app:tpIcon="@drawable/ic_add"
            android:background="@drawable/bg_fab_round"
            android:foreground="@drawable/press_oval_on_primary"
            android:minWidth="56dp"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:tpIconTint="@color/on_primary" />
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
