<?xml version="1.0" encoding="utf-8"?>
<!-- 장소 검색 창: 검색어 · 국내/해외 · 결과 목록 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_s">

    <com.tripplanner.ui.widget.TpTextField
        android:id="@+id/tilQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_hint"
        app:tpEndIconDescription="@string/search_place"
        app:tpEndIcon="@drawable/ic_search">
        <EditText
            android:id="@+id/etQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.tripplanner.ui.widget.TpTextField>

    <com.tripplanner.ui.SegmentedGroup
        style="@style/Widget.TripPlanner.SegmentedGroup"
        android:id="@+id/toggleRegion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s">
        <com.tripplanner.ui.widget.TpButton
            android:id="@+id/btnDomestic"
            style="@style/Widget.TripPlanner.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/search_domestic" />
        <com.tripplanner.ui.widget.TpButton
            android:id="@+id/btnOverseas"
            style="@style/Widget.TripPlanner.SegmentedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/search_overseas" />
    </com.tripplanner.ui.SegmentedGroup>

    <com.tripplanner.ui.widget.TpProgressBar
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
        android:textColor="@color/text_sub"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHits"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="@dimen/space_xs" />
</LinearLayout>
