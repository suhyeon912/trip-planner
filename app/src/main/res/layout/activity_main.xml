<?xml version="1.0" encoding="utf-8"?>
<!--
  메인 (시안 Main)
  상단 바 "여행 플래너" + 코드로 참여 / 보기 설정 줄 / 여행 카드 + 지난 여행 / 빈 상태 / 새 여행 FAB
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.tripplanner.ui.widget.TopBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tpScrollTarget="@id/rvTrips">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_marginTop="10dp"
            app:title="@string/title_my_trips"
            app:titleTextAppearance="@style/TextAppearance.TripPlanner.TitleLarge" />

        <!-- 전체 / 내 여행 / 초대받은 -->
        <!-- 세그먼트 바탕(안쪽 4)은 감싸는 칸이 그림: TabLayout 자체 패딩은 고정 모드에서 오른쪽이 무시되어 고른 칸이 끝에 붙음 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:background="@drawable/bg_segmented"
            android:padding="4dp">

            <com.tripplanner.ui.widget.TpTabs
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <!-- 보기 설정: 지금 정렬 · 지난 여행 상태 + 버튼 -->
        <LinearLayout
            android:id="@+id/viewRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:id="@+id/tvViewSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
                android:textColor="@color/text_sub"
                tools:text="일정 가까운 순 · 지난 여행 보임" />

            <com.tripplanner.ui.widget.TpButton
                android:id="@+id/btnViewSettings"
                style="@style/Widget.TripPlanner.Button.Text.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_m"
                android:text="@string/view_settings"
                app:tpIcon="@drawable/ic_tune" />
        </LinearLayout>
    </com.tripplanner.ui.widget.TopBarLayout>

    <!-- 상단 바 아래 내용 (목록 + 위에 뜨는 버튼) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTrips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="96dp"
            android:scrollbars="vertical" />

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="96dp"
            android:visibility="gone" />
    </FrameLayout>

    <com.tripplanner.ui.widget.TpFab
        android:id="@+id/fabNewTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_l"
        android:text="@string/new_trip"
        android:textColor="@color/on_primary"
        app:tpIcon="@drawable/ic_add"
        app:tpIconTint="@color/on_primary" />
    </FrameLayout>
</LinearLayout>
