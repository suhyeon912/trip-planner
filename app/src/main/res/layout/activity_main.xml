<?xml version="1.0" encoding="utf-8"?>
<!--
  메인 (시안 Main)
  상단 바 "여행 플래너" + 코드로 참여 / 보기 설정 줄 / 여행 카드 + 지난 여행 / 빈 상태 / 새 여행 FAB
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:liftOnScroll="true"
        app:liftOnScrollTargetViewId="@id/rvTrips">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:title="@string/title_my_trips"
            app:titleTextAppearance="@style/TextAppearance.TripPlanner.TitleLarge" />

        <!-- 보기 설정: 지금 정렬 · 지난 여행 상태 + 버튼 -->
        <LinearLayout
            android:id="@+id/viewRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/space_xs">

            <TextView
                android:id="@+id/tvViewSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
                android:textColor="@color/text_sub"
                tools:text="일정 가까운 순 · 지난 여행 보임" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewSettings"
                style="@style/Widget.TripPlanner.Button.Text.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/space_m"
                android:text="@string/view_settings"
                app:icon="@drawable/ic_tune" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTrips"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xs"
            android:paddingBottom="96dp"
            android:scrollbars="vertical" />

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="96dp"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabNewTrip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/space_l"
        android:text="@string/new_trip"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:icon="@drawable/ic_add"
        app:iconTint="@color/on_primary" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
