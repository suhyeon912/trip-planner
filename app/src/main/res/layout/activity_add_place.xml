<?xml version="1.0" encoding="utf-8"?>
<!--
  장소 추가 · 수정 (시안 AddPlace, 전체 화면)
  검색 / 사진 + 장소 이름* / 종류 칩 / 후보·확정 + 일차 / 운영 정보 / 위치 / 예약 필수 / 메모
  하단 바 취소 : 저장 = 1 : 2
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/add_place" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_xl">

            <!-- 검색 한 번으로 이름 · 위치 · 종류 · 운영시간 채우기 -->
            <com.tripplanner.ui.widget.TpButton
                android:id="@+id/btnSearchPlace"
                style="@style/Widget.TripPlanner.Button.Outlined.Rect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/search"
                app:tpIcon="@drawable/ic_search"
                app:tpIconGravity="textStart" />

            <!-- 사진 + 장소 이름 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/photoBox"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_dashed_add"
                    android:contentDescription="@string/pick_photo"
                    android:focusable="true"
                    android:clickable="true">

                    <ImageView
                        android:id="@+id/ivPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/photoEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center_horizontal"
                        android:importantForAccessibility="noHideDescendants"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/icon_size"
                            android:layout_height="@dimen/icon_size"
                            android:src="@drawable/ic_add_photo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/photo"
                            android:textAppearance="@style/TextAppearance.TripPlanner.LabelMedium"
                            android:textColor="@color/text_sub" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.TripPlanner.FieldLabel"
                        android:labelFor="@id/etName"
                        android:text="@string/hint_place_name" />

                    <com.tripplanner.ui.widget.TpTextField
                        android:id="@+id/tilName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.tripplanner.ui.widget.TpTextField>
                </LinearLayout>
            </LinearLayout>

            <!-- 종류 + ⓘ (종류는 설정에서 바꿈) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Widget.TripPlanner.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginBottom="0dp"
                    android:text="@string/label_category" />

                <ImageButton
                    android:id="@+id/btnCategoryInfo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="-4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/category_info_a11y"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_info"
                    app:tint="@color/text_sub" />
            </LinearLayout>

            <com.tripplanner.ui.widget.TpChipGroup
                android:id="@+id/chipsCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:tpSpacingH="@dimen/space_s"
                app:tpSpacingV="@dimen/space_s" />

            <!-- 후보 / 확정 + 일차 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.tripplanner.ui.SegmentedGroup
                    android:id="@+id/toggleStatus"
                    style="@style/Widget.TripPlanner.SegmentedGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.tripplanner.ui.widget.TpButton
                        android:id="@+id/btnCandidate"
                        style="@style/Widget.TripPlanner.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/status_candidate" />

                    <com.tripplanner.ui.widget.TpButton
                        android:id="@+id/btnConfirmed"
                        style="@style/Widget.TripPlanner.SegmentedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_confirm" />
                </com.tripplanner.ui.SegmentedGroup>

                <com.tripplanner.ui.SelectField
                    android:id="@+id/fieldDay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- 운영 정보 -->
            <TextView
                style="@style/Widget.TripPlanner.SectionTitle"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/section_hours" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Widget.TripPlanner.FieldLabel" android:labelFor="@id/etHours" android:text="@string/info_hours" />

                    <com.tripplanner.ui.widget.TpTextField
                        app:tpCompact="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tpPlaceholder="@string/placeholder_hours">

                        <EditText
                            android:id="@+id/etHours"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.tripplanner.ui.widget.TpTextField>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Widget.TripPlanner.FieldLabel" android:labelFor="@id/etBreak" android:text="@string/label_break" />

                    <com.tripplanner.ui.widget.TpTextField
                        app:tpCompact="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tpPlaceholder="@string/placeholder_break">

                        <EditText
                            android:id="@+id/etBreak"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.tripplanner.ui.widget.TpTextField>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Widget.TripPlanner.FieldLabel" android:labelFor="@id/etClosed" android:text="@string/info_closed" />

                    <com.tripplanner.ui.widget.TpTextField
                        app:tpCompact="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tpPlaceholder="@string/placeholder_closed">

                        <EditText
                            android:id="@+id/etClosed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />
                    </com.tripplanner.ui.widget.TpTextField>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Widget.TripPlanner.FieldLabel" android:labelFor="@id/etStay" android:text="@string/label_stay" />

                    <com.tripplanner.ui.widget.TpTextField
                        android:id="@+id/tilStay"
                        app:tpCompact="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:tpPlaceholder="60">

                        <EditText
                            android:id="@+id/etStay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.tripplanner.ui.widget.TpTextField>
                </LinearLayout>
            </LinearLayout>

            <!-- 위치 -->
            <TextView
                style="@style/Widget.TripPlanner.SectionTitle"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/section_location" />

            <TextView
                style="@style/Widget.TripPlanner.FieldLabel"
                android:labelFor="@id/etAddress"
                android:text="@string/label_address" />

            <!-- 주소: 검색하면 채워지고, 직접 고칠 수도 있음 (저장할 때 좌표로 바꿈) -->
            <com.tripplanner.ui.widget.TpTextField
                android:id="@+id/tilAddress"
                        app:tpCompact="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tpEndIconDescription="@string/location_search"
                app:tpEndIcon="@drawable/ic_search"
                app:tpPlaceholder="@string/placeholder_address">

                <EditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPostalAddress" />
            </com.tripplanner.ui.widget.TpTextField>

            <!-- 지금 위치 상태 · 위도·경도 직접 입력 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvLocState"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_xs"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
                    android:textColor="@color/text_sub" />

                <com.tripplanner.ui.widget.TpButton
                    android:id="@+id/btnLatLng"
                    style="@style/Widget.TripPlanner.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_s"
                    android:text="@string/location_manual" />
            </LinearLayout>

            <TextView
                style="@style/Widget.TripPlanner.FieldLabel"
                android:layout_marginTop="@dimen/space_s"
                android:labelFor="@id/etAddressDetail"
                android:text="@string/label_address_detail" />

            <com.tripplanner.ui.widget.TpTextField
                        app:tpCompact="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tpPlaceholder="@string/placeholder_address_detail">

                <EditText
                    android:id="@+id/etAddressDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.tripplanner.ui.widget.TpTextField>

            <TextView
                style="@style/Widget.TripPlanner.FieldLabel"
                android:layout_marginTop="@dimen/space_m"
                android:labelFor="@id/etLocationMemo"
                android:text="@string/label_location_memo" />

            <com.tripplanner.ui.widget.TpTextField
                        app:tpCompact="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tpPlaceholder="@string/placeholder_location_memo">

                <EditText
                    android:id="@+id/etLocationMemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.tripplanner.ui.widget.TpTextField>

            <!-- 예약 필수 (화면 안에서 켜고 끄는 값 하나 → 스위치) -->
            <com.tripplanner.ui.widget.TpSwitch
                android:id="@+id/switchReservation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_card"
                android:minHeight="56dp"
                android:paddingHorizontal="@dimen/space_l"
                android:text="@string/reservation_switch"
                android:textAppearance="@style/TextAppearance.TripPlanner.BodyLarge" />

            <!-- 메모 -->
            <TextView
                style="@style/Widget.TripPlanner.FieldLabel"
                android:layout_marginTop="@dimen/space_l"
                android:labelFor="@id/etMemo"
                android:text="@string/memo_label" />

            <com.tripplanner.ui.widget.TpTextField
                        app:tpCompact="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etMemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minHeight="84dp" />
            </com.tripplanner.ui.widget.TpTextField>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout style="@style/Widget.TripPlanner.BottomBar">

        <com.tripplanner.ui.widget.TpButton
            android:id="@+id/btnCancel"
            style="@style/Widget.TripPlanner.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/action_cancel" />

        <com.tripplanner.ui.widget.TpButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="2"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
