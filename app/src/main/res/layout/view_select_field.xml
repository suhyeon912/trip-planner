<?xml version="1.0" encoding="utf-8"?>
<!-- SelectField.kt 의 내용: 칸(아이콘 · 값 · ▾/›) + 오류 한 줄 -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/selectBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_select_field"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:id="@+id/selectIcon"
            android:layout_width="@dimen/icon_small"
            android:layout_height="@dimen/icon_small"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <TextView
            android:id="@+id/selectValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodyLarge" />

        <ImageView
            android:id="@+id/selectEnd"
            android:layout_width="@dimen/icon_small"
            android:layout_height="@dimen/icon_small"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_sub" />
    </LinearLayout>

    <TextView
        android:id="@+id/selectError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_xs"
        android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
        android:textColor="@color/badge_red"
        android:visibility="gone" />
</merge>
