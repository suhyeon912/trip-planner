<?xml version="1.0" encoding="utf-8"?>
<!-- 빈 화면 공통: 아이콘 + 제목 + 설명 + 버튼 1개 (EmptyState.kt 의 bindEmptyState 로 채움) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_xl">

    <ImageView
        android:id="@+id/emptyIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_empty_icon"
        android:importantForAccessibility="no"
        android:padding="18dp"
        android:src="@drawable/ic_place" />

    <TextView
        android:id="@+id/emptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall" />

    <TextView
        android:id="@+id/emptyBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
        android:textColor="@color/text_sub" />

    <com.tripplanner.ui.widget.TpButton
        android:id="@+id/emptyAction"
        style="@style/Widget.TripPlanner.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l" />
</LinearLayout>
