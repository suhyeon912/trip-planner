<?xml version="1.0" encoding="utf-8"?>
<!--
  여행 상세의 '지도로 보기' (시안 DetailMap · DetailMapAll, 목록 대신 보임)
  지도 + 왼쪽 위 '일차 미정 n' · 점을 누르면 장소 카드 · 아래 '지도에 없는 장소' 판
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 지도 칸: 국내는 카카오맵, 해외는 Google Maps, 키가 없으면 OpenStreetMap (MapHost) -->
        <FrameLayout
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/map_a11y" />

        <TextView
            android:id="@+id/mapNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_m"
            android:background="@drawable/bg_map_pill"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textAppearance="@style/TextAppearance.TripPlanner.LabelMedium"
            android:textColor="@color/on_surface"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_place_small" />

        <include
            android:id="@+id/mapCard"
            layout="@layout/view_map_place_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/space_m"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 지도에 없는 장소 (위치가 없는 장소 → 위치 찾기) -->
    <LinearLayout
        android:id="@+id/missingPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet_top"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvMissingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/missingScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/missingRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
