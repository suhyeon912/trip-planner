<?xml version="1.0" encoding="utf-8"?>
<!--
  교통 · 숙소 (시안 TravelInfo)
  상단 바 / 교통편 n: 묶음 카드 + 점선 '교통편 추가' / 숙소 n: 묶음 카드 + 점선 '숙소 추가'
  줄을 누르면 수정, ⋮ → 수정 / 삭제
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.tripplanner.ui.widget.TopBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tpScrollTarget="@id/scroll">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/menu_travel_info" />
    </com.tripplanner.ui.widget.TopBarLayout>

    <!-- 상단 바 아래 내용 (목록 + 위에 뜨는 버튼) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:id="@+id/tvFlightTitle"
                style="@style/Widget.TripPlanner.SectionTitle"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/flights" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:nestedScrollingEnabled="false" />

            <com.tripplanner.ui.widget.TpButton
                android:id="@+id/btnAddFlight"
                style="@style/Widget.TripPlanner.Button.DashedAdd"
                android:layout_height="wrap_content"
                android:text="@string/add_flight"
                app:tpIcon="@drawable/ic_add" />

            <TextView
                android:id="@+id/tvLodgingTitle"
                style="@style/Widget.TripPlanner.SectionTitle"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_s"
                android:text="@string/lodgings" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLodgings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:background="@drawable/bg_card"
                android:nestedScrollingEnabled="false" />

            <com.tripplanner.ui.widget.TpButton
                android:id="@+id/btnAddLodging"
                style="@style/Widget.TripPlanner.Button.DashedAdd"
                android:layout_height="wrap_content"
                android:text="@string/add_lodging"
                app:tpIcon="@drawable/ic_add" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
