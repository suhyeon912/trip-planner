<?xml version="1.0" encoding="utf-8"?>
<!--
  장소 한 줄 (시안 PlaceCard: 최소 64 · 순서 점 28 + 종류 타일 44 + 뱃지 최대 2개 + ⠿)
  - 타임라인 열: 위 선 · 점(방문 순서 숫자 또는 빈 원) · 아래 선. 후보 탭에서는 숨김
  - 카드: 한 번 누르면 장소 정보, 길게 누르면 장소 수정
  - 후보 카드: '확정하기' 작은 버튼
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_margin">

    <LinearLayout
        android:id="@+id/timeline"
        android:layout_width="@dimen/timeline_dot"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_s"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <View
            android:id="@+id/lineAbove"
            android:layout_width="2dp"
            android:layout_height="22dp"
            android:background="@color/outline_variant" />

        <TextView
            android:id="@+id/tvDot"
            android:layout_width="@dimen/timeline_dot"
            android:layout_height="@dimen/timeline_dot"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge"
            android:textColor="@color/white" />

        <View
            android:id="@+id/lineBelow"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/outline_variant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="4dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="80dp"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_s"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="0dp">

        <ImageView
            android:id="@+id/ivThumb"
            android:layout_width="@dimen/thumb_size"
            android:layout_height="@dimen/thumb_size"
            android:layout_marginEnd="@dimen/space_m"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlaceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall"
                tools:text="도쿄 스카이트리" />

            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
                android:textColor="@color/text_sub"
                tools:text="영업 10:00–21:00" />

            <LinearLayout
                android:id="@+id/badges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="horizontal" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/Widget.TripPlanner.Button.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_s"
            android:textSize="13sp"
            android:text="@string/confirm_pick"
            app:icon="@drawable/ic_check" />

        <!-- 일차를 고른 타임라인에서만: 끌면 순서 변경 -->
        <ImageView
            android:id="@+id/ivDrag"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:importantForAccessibility="no"
            android:paddingVertical="12dp"
            android:src="@drawable/ic_drag"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
