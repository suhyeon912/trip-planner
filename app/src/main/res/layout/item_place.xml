<?xml version="1.0" encoding="utf-8"?>
<!--
  장소 한 줄 = [타임라인 열] + [카드]
  - 타임라인 열: 위 선 · 점(방문 순서 숫자 또는 빈 원) · 아래 선. 후보 탭에서는 숨김
  - 카드 머리줄(누르면 펼침): 이름 / 운영시간·머무는 시간 / 브레이크 뱃지 · 예약필수 · [확정](후보) · 펼침 아이콘
  - 펼친 영역: 정보 행들 · 메모 · [지도] [메모] [수정] … [⋮]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_margin">

    <LinearLayout
        android:id="@+id/timeline"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_m"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <View
            android:id="@+id/lineAbove"
            android:layout_width="2dp"
            android:layout_height="14dp"
            android:background="@color/outline_variant" />

        <TextView
            android:id="@+id/tvDot"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge"
            android:textColor="@color/white" />

        <View
            android:id="@+id/lineBelow"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/outline_variant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_s"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <!-- 머리줄 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/space_s"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_xs">

            <!-- 장소 사진 또는 종류 아이콘 (디자인 2차) -->
            <ImageView
                android:id="@+id/ivThumb"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/space_m"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlaceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall" />

                <TextView
                    android:id="@+id/tvSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:id="@+id/badges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReservationBadge"
                        style="@style/Widget.TripPlanner.Badge"
                        android:layout_marginEnd="@dimen/space_xs"
                        android:background="@drawable/bg_badge"
                        android:text="@string/reservation_required"
                        android:textColor="@color/on_error_container" />

                    <TextView
                        android:id="@+id/tvBreakBadge"
                        style="@style/Widget.TripPlanner.Badge"
                        android:background="@drawable/bg_warn_badge"
                        android:textColor="@color/warn_text" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnConfirm"
                style="@style/Widget.TripPlanner.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/action_confirm"
                app:icon="@drawable/ic_check" />

            <!-- 일차를 고른 타임라인에서만: 길게 눌러 끌면 순서 변경 -->
            <ImageView
                android:id="@+id/ivDrag"
                android:layout_width="32dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:paddingVertical="8dp"
                android:src="@drawable/ic_drag"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivExpand"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_expand_more" />
        </LinearLayout>

        <!-- 펼친 영역 -->
        <LinearLayout
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingBottom="@dimen/space_xs"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/space_s"
                android:background="@color/outline_variant" />

            <LinearLayout
                android:id="@+id/infoRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMap"
                    style="@style/Widget.TripPlanner.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_map" />

                <Button
                    android:id="@+id/btnMemo"
                    style="@style/Widget.TripPlanner.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_memo" />

                <Button
                    android:id="@+id/btnEdit"
                    style="@style/Widget.TripPlanner.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/action_edit" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnMore"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more_vert" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
