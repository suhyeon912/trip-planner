<?xml version="1.0" encoding="utf-8"?>
<!-- 지도에 없는 장소 한 줄: 종류 타일 · 이름 · (일차) · [위치 찾기] -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/space_m">

    <ImageView
        android:id="@+id/ivMissingThumb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMissingName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall"
            tools:text="쓰키지 장외시장" />

        <TextView
            android:id="@+id/tvMissingSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
            android:textColor="@color/text_sub"
            tools:text="1일차" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFindLocation"
        style="@style/Widget.TripPlanner.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:paddingHorizontal="@dimen/space_m"
        android:text="@string/find_location"
        app:icon="@drawable/ic_search"
        app:iconSize="18dp" />
</LinearLayout>
