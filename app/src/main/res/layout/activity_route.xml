<?xml version="1.0" encoding="utf-8"?>
<!--
  경로 제안 (4단계 구조)
  ┌ 툴바(뒤로 · 경로 제안 · 추정 기준)
  ├ 일차 칩 (여행 상세와 같은 컴포넌트)
  ├ 계산 중 표시줄
  ├ 스크롤 영역: 날짜·숙소 / 안내 / A·B·C 요약 카드(하나 선택) / 선택한 안의 설명·시간표 / 빈 상태
  └ 하단 고정 바: [지도 길찾기] [n안으로 확정]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/title_route"
        app:subtitle="@string/route_subtitle"
        app:subtitleTextAppearance="@style/TextAppearance.TripPlanner.LabelMedium" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_s" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_l">

            <!-- 날짜 · 숙소 출발/도착 + 출발 시각 바꾸기 (디자인 2차) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartTime"
                    style="@style/Widget.TripPlanner.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:minHeight="40dp"
                    android:paddingHorizontal="12dp"
                    android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge"
                    app:icon="@drawable/ic_schedule"
                    app:iconSize="18dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_warn"
                android:padding="@dimen/space_s"
                android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
                android:textColor="@color/warn_text"
                android:visibility="gone" />

            <!-- 선택한 안을 지도로: 숙소 → 번호 순서 → 숙소 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/mapCard"
                android:layout_width="match_parent"
                android:layout_height="@dimen/route_map_height"
                android:layout_marginTop="@dimen/space_m"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="@dimen/stroke_card">

                <!-- 지도 칸: 국내는 카카오맵, 해외는 구글맵, 키가 없으면 OpenStreetMap (MapHost) -->
                <FrameLayout
                    android:id="@+id/routeMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="@dimen/space_s"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/routeMapLegend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_map_overlay"
                        android:drawablePadding="@dimen/space_xs"
                        android:paddingHorizontal="@dimen/space_s"
                        android:paddingVertical="@dimen/space_xs"
                        android:text="@string/legend_added"
                        android:textAppearance="@style/TextAppearance.TripPlanner.LabelMedium"
                        android:textColor="@color/on_surface"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/routeMapLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/bg_map_overlay"
                        android:paddingHorizontal="@dimen/space_s"
                        android:paddingVertical="@dimen/space_xs"
                        android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge"
                        android:textColor="@color/on_surface"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- A/B/C 요약 카드 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:nestedScrollingEnabled="false" />

            <!-- 선택한 안 -->
            <LinearLayout
                android:id="@+id/selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOptionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.TripPlanner.TitleMedium" />

                <TextView
                    android:id="@+id/tvOptionDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvOptionSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge"
                    android:textColor="@color/primary" />



                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStops"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <include
                android:id="@+id/emptyState"
                layout="@layout/view_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 고정 바 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_bar"
        android:elevation="3dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingVertical="@dimen/space_s">

        <Button
            android:id="@+id/btnRouteMap"
            style="@style/Widget.TripPlanner.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_s"
            android:layout_weight="1"
            app:icon="@drawable/ic_map" />

        <Button
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/on_primary" />
    </LinearLayout>
</LinearLayout>
