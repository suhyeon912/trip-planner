<?xml version="1.0" encoding="utf-8"?>
<!-- 일차 제목: ● 1일차 11월 20일 (금) · ('전체'에서는) 오른쪽 '경로 제안' -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityHeading="true"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingEnd="@dimen/space_xs"
    android:paddingTop="@dimen/space_s"
    tools:targetApi="28">

    <View
        android:id="@+id/vHeaderDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="@dimen/space_s"
        android:background="@drawable/bg_dot"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall"
        android:textColor="@color/on_surface"
        tools:text="1일차" />

    <TextView
        android:id="@+id/tvHeaderSub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
        android:textColor="@color/text_sub"
        tools:text="11월 20일 (금)" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHeaderRoute"
        style="@style/Widget.TripPlanner.Button.Text.Icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_m"
        android:text="@string/route_link"
        app:icon="@drawable/ic_route" />
</LinearLayout>
