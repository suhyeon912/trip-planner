<?xml version="1.0" encoding="utf-8"?>
<!-- 정보 한 줄 (시안 InfoRows: 줄 48 · 아이콘 + 라벨 + 값 · 사이 1px 선) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="4dp"
        android:minHeight="56dp">

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="@dimen/icon_small"
            android:layout_height="@dimen/icon_small"
            android:layout_marginEnd="@dimen/space_m"
            android:importantForAccessibility="no"
            app:tint="@color/text_sub" />

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_m"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
            android:textColor="@color/text_sub"
            tools:text="운영시간" />

        <TextView
            android:id="@+id/tvValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall"
            android:textSize="15sp"
            tools:text="11:00 – 21:00" />
    </LinearLayout>
</LinearLayout>
