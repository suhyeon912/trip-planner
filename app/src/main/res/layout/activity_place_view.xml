<?xml version="1.0" encoding="utf-8"?>
<!--
  장소 정보 (시안 PlaceView, 읽기 전용)
  상단 바(뒤로 · 장소 정보 · ⋮ 수정/삭제) / 종류 타일 + 이름 + 뱃지 / 지도 버튼 / 운영 정보
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.tripplanner.ui.widget.TopBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tpScrollTarget="@id/scroll">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/place_info_title" />
    </com.tripplanner.ui.widget.TopBarLayout>

    <!-- 상단 바 아래 내용 (목록 + 위에 뜨는 버튼) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">


    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/space_s"
            android:paddingBottom="@dimen/space_xxl">

            <!-- 머리: 종류 타일(또는 사진) + 이름 + 종류 · 상태 · 예약필수 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivThumb"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.TripPlanner.TitleLarge"
                        tools:targetApi="28"
                        tools:text="츠지한 니혼바시" />

                    <!-- 줄이 넘치면 다음 줄로 (ChipGroup 은 줄바꿈 배치만 씀) -->
                    <com.tripplanner.ui.widget.FlowLayout
                        android:id="@+id/chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:tpSpacingH="6dp"
                        app:tpSpacingV="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 지도 버튼: 지도 앱에서 보기 · 여행 지도에서 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="horizontal">

                <com.tripplanner.ui.widget.TpButton
                    android:id="@+id/btnOpenMap"
                    style="@style/Widget.TripPlanner.Button.Outlined.Rect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:tpIconGravity="textStart"
                    app:tpIconSize="24dp"
                    tools:text="Google Maps에서 보기" />

                <com.tripplanner.ui.widget.TpButton
                    android:id="@+id/btnTripMap"
                    style="@style/Widget.TripPlanner.Button.Outlined.Rect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_s"
                    android:layout_weight="1"
                    android:text="@string/show_on_trip_map"
                    app:tpIcon="@drawable/ic_place"
                    app:tpIconGravity="textStart" />
            </LinearLayout>

            <TextView
                style="@style/Widget.TripPlanner.SectionTitle"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="@dimen/space_m"
                android:text="@string/section_hours" />

            <LinearLayout
                android:id="@+id/infoRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
