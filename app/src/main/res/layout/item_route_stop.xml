<?xml version="1.0" encoding="utf-8"?>
<!--
  시간표 한 줄 (시안 TimelineRow): 시각 44(도착 굵게 / 떠남 회색) · 점 32(종류 타일 또는 숙소) · 이름 15
  문제 있는 장소는 노란 바탕 + 이유 한 줄
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/stopRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_s"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_s"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvArrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall"
            tools:text="10:10" />

        <TextView
            android:id="@+id/tvLeave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_code_box"
            android:foreground="@drawable/press_r12"
            android:gravity="center"
            android:minHeight="28dp"
            android:paddingVertical="2dp"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
            android:textColor="@color/text_sub"
            tools:text="11:40" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivStopIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/space_xs"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall"
            tools:text="도쿄 스카이트리" />

        <TextView
            android:id="@+id/tvStopSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
            android:textColor="@color/text_sub"
            android:visibility="gone"
            tools:text="문 열 때까지 20분 기다려요" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivWarn"
        android:layout_width="@dimen/icon_small"
        android:layout_height="@dimen/icon_small"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_warning"
        android:visibility="gone"
        app:tint="@color/warn_text" />
</LinearLayout>
