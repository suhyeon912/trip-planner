<?xml version="1.0" encoding="utf-8"?>
<!-- 선택한 경로의 시간표 한 줄: [타임라인 점] 이름 / 도착 시각·머무름 / 경고·대기·후보 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/space_m"
        android:gravity="center_horizontal"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical">

        <View
            android:id="@+id/lineAbove"
            android:layout_width="2dp"
            android:layout_height="6dp"
            android:background="@color/outline_variant" />

        <FrameLayout
            android:id="@+id/dotFrame"
            android:layout_width="28dp"
            android:layout_height="28dp">
            <TextView
                android:id="@+id/tvDot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge"
                android:textColor="@color/on_primary" />
            <ImageView
                android:id="@+id/ivDotIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_hotel"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/lineBelow"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/outline_variant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="@dimen/space_m">

        <TextView
            android:id="@+id/tvStopName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall" />

        <TextView
            android:id="@+id/tvStopMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvCandidate"
            style="@style/Widget.TripPlanner.Badge"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_chip"
            android:text="@string/added_from_candidates"
            android:textColor="@color/on_primary_container"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvWait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvWarn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_warn"
            android:drawablePadding="@dimen/space_xs"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="@dimen/space_xs"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
            android:textColor="@color/warn_text"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
