<?xml version="1.0" encoding="utf-8"?>
<!-- 경로 선택지 카드 (시안 RouteCard): [A] 이름 · 거리 · (✓추천 / ⚠확인 n) / 순서 · 숙소 도착 시각. 고르면 primary 2 테두리 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:background="@drawable/bg_option"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:padding="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvKey"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_dot"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.TripPlanner.LabelMedium"
            tools:text="A" />

        <TextView
            android:id="@+id/tvOptionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.TripPlanner.TitleSmall"
            tools:text="최단 경로 · 15.5km" />

        <TextView
            android:id="@+id/tvWarnBadge"
            style="@style/Widget.TripPlanner.Badge"
            android:drawablePadding="2dp"
            android:gravity="center_vertical"
            tools:text="추천" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall"
        android:textColor="@color/text_sub"
        tools:text="스카이트리 → 블루보틀 → 츠지한 · 16:43 숙소 도착" />
</LinearLayout>
