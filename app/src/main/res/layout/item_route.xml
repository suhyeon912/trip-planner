<?xml version="1.0" encoding="utf-8"?>
<!-- 경로 요약 카드 (A/B/C 중 하나). 누르면 선택 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/optionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_xs"
    android:background="@drawable/bg_option"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/touch_min"
    android:orientation="vertical"
    android:padding="@dimen/space_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvKey"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_key"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.TripPlanner.LabelMedium"
            android:textColor="@color/on_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOptionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:importantForAccessibility="no"
        android:textAppearance="@style/TextAppearance.TripPlanner.BodySmall" />

    <TextView
        android:id="@+id/tvWarnBadge"
        style="@style/Widget.TripPlanner.Badge"
        android:layout_marginTop="@dimen/space_s"
        android:importantForAccessibility="no" />
</LinearLayout>
