<?xml version="1.0" encoding="utf-8"?>
<!-- 공유 중: 초대 코드를 크게 · 함께 보는 사람 수 · 안내 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_s">

    <TextView
        android:id="@+id/tvCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip"
        android:backgroundTint="@color/primary_light"
        android:gravity="center"
        android:letterSpacing="0.25"
        android:paddingVertical="@dimen/space_l"
        android:textAppearance="@style/TextAppearance.TripPlanner.M3.DisplaySmall"
        android:textColor="@color/on_primary_container"
        android:textIsSelectable="true"
        tools:text="ABC234" />

    <TextView
        android:id="@+id/tvMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge"
        tools:text="2명이 함께 보는 중" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:text="@string/share_code_help"
        android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
</LinearLayout>
