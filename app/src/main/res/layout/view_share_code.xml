<?xml version="1.0" encoding="utf-8"?>
<!-- 공유 중 (시안 DetailShare): 초대 코드 상자(코드 + 복사) · 함께 보는 사람 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_s">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_code_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_m"
        android:paddingStart="@dimen/space_l"
        android:paddingEnd="@dimen/space_xs">

        <TextView
            android:id="@+id/tvCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_bold"
            android:letterSpacing="0.2"
            android:textColor="@color/on_surface"
            android:textIsSelectable="true"
            android:textSize="28sp"
            tools:text="3CEQEP" />

        <com.tripplanner.ui.widget.TpButton
            android:id="@+id/btnCopy"
            style="@style/Widget.TripPlanner.Button.Text.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_m"
            android:text="@string/share_copy"
            app:tpIcon="@drawable/ic_copy" />
    </LinearLayout>

    <!-- 함께 보는 사람: 겹친 머리글자 동그라미 + 이름 · 오른쪽 '활동 기록 ›' -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="-12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/avatars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_m"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvMembers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.TripPlanner.BodyMedium"
            android:textColor="@color/on_surface"
            tools:text="지우 · 민지 · 하준" />

        <TextView
            android:id="@+id/btnActivity"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/press_pill_primary"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="2dp"
            android:drawableTint="@color/primary"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:text="@string/activity_log"
            android:textAppearance="@style/TextAppearance.TripPlanner.LabelLarge"
            android:textColor="@color/primary" />
    </LinearLayout>
</LinearLayout>
