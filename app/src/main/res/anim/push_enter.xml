<?xml version="1.0" encoding="utf-8"?>
<!-- 상세 화면 열림: 오른쪽에서 조금 밀려 들어오며 나타남 (300ms, 감속) -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/motion_decelerate"
    android:zAdjustment="top">
    <translate android:duration="@integer/motion_page" android:fromXDelta="12%" android:toXDelta="0" />
    <alpha android:duration="@integer/motion_medium" android:fromAlpha="0" android:toAlpha="1" />
</set>
